# Copy this file to .env and fill in your key.
# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your-key-here

# Optional overrides. If a model returns NOT_FOUND, pick another from AI Studio.
# Free daily quota is per model. Newer models get much smaller allowances
# (gemini-3.5-flash = 20 requests/day), so prefer an older Flash-Lite.
CHAT_MODEL=gemini-3.1-flash-lite
EMBED_MODEL=gemini-embedding-001

# Origins allowed to call the chat API from your website. Comma-separated.
ALLOWED_ORIGINS=http://localhost:3000,https://your-domain.com

DATA_SOURCE=mysql_api
TOOLHOO_API_URL=http://127.0.0.1:8001/api/chatbot
